# Γειτονιές της Αθήνας — ρυθμίσεις για Apache / LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.html

# Τύποι αρχείων του χάρτη
AddType application/octet-stream .pmtiles
AddType application/x-protobuf .pbf
AddType application/json .json

<IfModule mod_headers.c>
  # Όλα φορτώνονται από τον δικό μας server: καμία κλήση σε τρίτους.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
  # Το υπόβαθρο διαβάζεται τμηματικά (HTTP range requests)
  <FilesMatch "\.pmtiles$">
    Header set Accept-Ranges "bytes"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Γραμματοσειρές και glyphs: δεν αλλάζουν
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/x-protobuf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Σελίδα, κώδικας και δεδομένα: ο browser ελέγχει πάντα αν άλλαξαν (γρήγορο 304),
  # ώστε μετά από κάθε ενημέρωση όλοι οι πολίτες να βλέπουν αμέσως τη νέα έκδοση.
  <FilesMatch "\.(html|css|js|json|pmtiles)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Συμπίεση κειμένου. ΟΧΙ στο .pmtiles: τα tiles είναι ήδη συμπιεσμένα και η συμπίεση χαλά τα range requests.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  SetEnvIfNoCase Request_URI "\.pmtiles$" no-gzip dont-vary
</IfModule>

# Ανακατεύθυνση σε HTTPS (απαραίτητο για τον εντοπισμό θέσης στα κινητά)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.athenshoods.gr → athenshoods.gr (μία διεύθυνση για όλους)
  RewriteCond %{HTTP_HOST} ^www\.athenshoods\.gr$ [NC]
  RewriteRule ^(.*)$ https://athenshoods.gr/$1 [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
